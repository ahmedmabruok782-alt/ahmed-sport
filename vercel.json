{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/google519f6f89d95e2bc9.html",
      "destination": "/api?__seo=google-verify"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api?__seo=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api?__seo=robots"
    },
    {
      "source": "/api/v1/:endpoint",
      "destination": "/api?__endpoint=:endpoint"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?__apipath=:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "/api?__mediapath=:path*"
    },
    {
      "source": "/((?!api/|media/|assets/|google519f6f89d95e2bc9\\.html|sitemap\\.xml|robots\\.txt|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
